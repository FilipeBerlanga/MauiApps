<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="Resumo"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#0F172A">

    <ScrollView>
        <VerticalStackLayout VerticalOptions="Center"
                             Padding="20,30"
                             Spacing="20">

            <!-- Título Principal -->
            <Label Text="Resumo da Hospedagem"
                   FontFamily="Kalam"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#38BDF8" />

            <!-- Card Principal (Frame Escuro) -->
            <Frame Padding="20" 
                   BackgroundColor="#1E293B" 
                   BorderColor="#334155" 
                   CornerRadius="16">

                <VerticalStackLayout Spacing="14">

                    <!-- Nome da Acomodação -->
                    <Label Text="{Binding QuartoSelecionado.Descricao, StringFormat='Acomodação: {0}'}" 
                           FontAttributes="Bold" 
                           FontSize="18" 
                           TextColor="#F8FAFC" />

                    <BoxView HeightRequest="1" Color="#334155" Margin="0,2" />

                    <!-- Detalhes da Estadia em Grid -->
                    <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto"
                          ColumnDefinitions="*, Auto"
                          RowSpacing="10">

                        <Label Grid.Row="0" Grid.Column="0" Text="Adultos:" TextColor="#94A3B8" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding QtdAdultos}" FontAttributes="Bold" TextColor="#F8FAFC" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Crianças:" TextColor="#94A3B8" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding QtdCriancas}" FontAttributes="Bold" TextColor="#F8FAFC" />

                        <Label Grid.Row="2" Grid.Column="0" Text="Check-in:" TextColor="#94A3B8" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding DataCheckIn, StringFormat='{0:dd/MM/yyyy}'}" FontAttributes="Bold" TextColor="#F8FAFC" />

                        <Label Grid.Row="3" Grid.Column="0" Text="Check-out:" TextColor="#94A3B8" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding DataCheckOut, StringFormat='{0:dd/MM/yyyy}'}" FontAttributes="Bold" TextColor="#F8FAFC" />

                        <Label Grid.Row="4" Grid.Column="0" Text="Período:" TextColor="#94A3B8" />
                        <Label Grid.Row="4" Grid.Column="1" Text="{Binding Stays, StringFormat='{0} diária (s)'}" FontAttributes="Bold" TextColor="#F8FAFC" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#334155" Margin="0,5" />

                    <!-- Valor Total em Destaque Neon -->
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center" Margin="0,5">
                        <Label Text="VALOR TOTAL" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="#94A3B8" 
                               HorizontalOptions="Center" />

                        <Label Text="{Binding ValorTotal, StringFormat='{0:C}'}" 
                               FontSize="28" 
                               TextColor="#38BDF8" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <!-- Botão Voltar (Índigo) -->
            <Button Text="Voltar / Alterar" 
                    Clicked="BtnVoltar_Clicked" 
                    BackgroundColor="#6366F1" 
                    TextColor="#FFFFFF" 
                    FontAttributes="Bold" 
                    CornerRadius="20" 
                    HeightRequest="48" 
                    WidthRequest="220" 
                    HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>