<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="ContratacaoHospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#0F172A">

    <ScrollView>
        <VerticalStackLayout VerticalOptions="Center"
                             Padding="20,30"
                             Spacing="15">

            <!-- Título Principal -->
            <Label Text="Cálculo da Diária"
                   FontFamily="Kalam"
                   FontSize="44"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#38BDF8" />

            <!-- Card Principal (Frame Escuro) -->
            <Frame Padding="15" 
                   BackgroundColor="#1E293B" 
                   BorderColor="#334155" 
                   CornerRadius="16">

                <VerticalStackLayout Spacing="15">

                    <!-- Grid dos Steppers (Adultos e Crianças) -->
                    <Grid RowDefinitions="Auto, Auto"
                          ColumnDefinitions="*, *, 2*"
                          RowSpacing="12">

                        <!-- Adultos -->
                        <Label Grid.Row="0" Grid.Column="0"
                               Text="Adultos:" 
                               VerticalOptions="Center"
                               TextColor="#94A3B8" />

                        <Label Grid.Row="0" Grid.Column="1"
                               TextColor="#38BDF8"
                               FontAttributes="Bold"
                               FontSize="18"
                               VerticalOptions="Center"
                               Text="{Binding Value}"
                               BindingContext="{x:Reference stp_adultos}"/>

                        <Stepper Grid.Row="0" Grid.Column="2"
                                 x:Name="stp_adultos"
                                 Minimum="1"
                                 Maximum="10"
                                 Increment="1" />

                        <!-- Crianças -->
                        <Label Grid.Row="1" Grid.Column="0"
                               Text="Crianças:" 
                               VerticalOptions="Center"
                               TextColor="#94A3B8" />

                        <Label Grid.Row="1" Grid.Column="1"
                               TextColor="#38BDF8"
                               FontAttributes="Bold"
                               FontSize="18"
                               VerticalOptions="Center"
                               Text="{Binding Value}"
                               BindingContext="{x:Reference stp_criancas}"/>

                        <Stepper Grid.Row="1" Grid.Column="2"
                                 x:Name="stp_criancas"
                                 Minimum="0"
                                 Maximum="10"
                                 Increment="1" />
                    </Grid>

                    <!-- Frame: Escolha sua Suíte -->
                    <Frame Padding="15" 
                           Margin="0,5" 
                           BackgroundColor="#0F172A" 
                           BorderColor="#334155" 
                           CornerRadius="12">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Escolha sua Suíte"
                                   TextTransform="Uppercase"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#38BDF8"/>

                            <Picker x:Name="pck_quarto"
                                    Title="Selecione sua Acomodação" 
                                    TitleColor="#94A3B8"
                                    TextColor="#F8FAFC"
                                    ItemDisplayBinding="{Binding Descricao}"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Frame: Período da Estadia -->
                    <Frame Padding="15"
                           Margin="0,5"
                           BackgroundColor="#0F172A" 
                           BorderColor="#334155" 
                           CornerRadius="12">
                        <VerticalStackLayout Spacing="12">

                            <Label Text="Período da Estadia"
                                   TextTransform="Uppercase"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#38BDF8"/>

                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Check-in:" VerticalOptions="Center" TextColor="#94A3B8" />
                                <DatePicker Grid.Column="1"
                                            x:Name="dtpck_checkin"
                                            Format="dd/MM/yyyy" 
                                            TextColor="#F8FAFC"
                                            DateSelected="dtpck_checkin_DateSelected"/>
                            </Grid>

                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Check-out:" VerticalOptions="Center" TextColor="#94A3B8" />
                                <DatePicker Grid.Column="1"
                                            x:Name="dtpck_checkout"
                                            Format="dd/MM/yyyy"
                                            TextColor="#F8FAFC"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Botão Avançar (Índigo) -->
                    <Button Text="Avançar" 
                            Clicked="Btn_Clicked" 
                            BackgroundColor="#6366F1"
                            TextColor="#FFFFFF"
                            FontAttributes="Bold"
                            CornerRadius="20"
                            HeightRequest="48"
                            Margin="0,10,0,0" />

                    <!-- Botão Sobre (Texto Celeste) -->
                    <!--   <Button Text="Sobre o Aplicativo" 
                            Clicked="BtnSobre_Clicked" 
                            BackgroundColor="Transparent"
                            TextColor="#38BDF8"
                            FontAttributes="Bold" /> -->
                    <Button Text="Voltar ao Menu Principal"
                            Clicked="BtnVoltar_Clicked"
                            BackgroundColor="Transparent"
                            TextColor="#94A3B8"
                            FontAttributes="Bold" />

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>