<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ResumoEventoPage"
             Title="Resumo do Evento"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#0F172A">

    <ScrollView>
        <VerticalStackLayout Padding="20,30" Spacing="20" VerticalOptions="Center">

            <Label Text="Resumo do Evento"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#38BDF8" />

            <Frame Padding="20" BackgroundColor="#1E293B" BorderColor="#334155" CornerRadius="16">
                <VerticalStackLayout Spacing="14">

                    <!-- Nome e Local -->
                    <Label Text="{Binding Nome}" FontAttributes="Bold" FontSize="20" TextColor="#F8FAFC" />
                    <Label Text="{Binding Local, StringFormat='Local: {0}'}" TextColor="#94A3B8" FontSize="15" />

                    <BoxView HeightRequest="1" Color="#334155" Margin="0,2" />

                    <!-- Tabela de Detalhes -->
                    <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto"
                          ColumnDefinitions="*, Auto"
                          RowSpacing="10">

                        <Label Grid.Row="0" Grid.Column="0" Text="Data de Início:" TextColor="#94A3B8" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding DataInicio, StringFormat='{0:dd/MM/yyyy}'}" FontAttributes="Bold" TextColor="#F8FAFC" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Data de Término:" TextColor="#94A3B8" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding DataTermino, StringFormat='{0:dd/MM/yyyy}'}" FontAttributes="Bold" TextColor="#F8FAFC" />

                        <Label Grid.Row="2" Grid.Column="0" Text="Duração:" TextColor="#94A3B8" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding DuracaoEmDias, StringFormat='{0} dia(s)'}" FontAttributes="Bold" TextColor="#F8FAFC" />

                        <Label Grid.Row="3" Grid.Column="0" Text="Participantes:" TextColor="#94A3B8" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding NumeroParticipantes}" FontAttributes="Bold" TextColor="#F8FAFC" />

                        <Label Grid.Row="4" Grid.Column="0" Text="Custo por Participante:" TextColor="#94A3B8" />
                        <Label Grid.Row="4" Grid.Column="1" Text="{Binding CustoPorParticipante, StringFormat='{0:C}'}" FontAttributes="Bold" TextColor="#F8FAFC" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#334155" Margin="0,5" />

                    <!-- Custo Total Formatado -->
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center" Margin="0,5">
                        <Label Text="CUSTO TOTAL DO EVENTO" FontSize="12" FontAttributes="Bold" TextColor="#94A3B8" HorizontalOptions="Center" />
                        <Label Text="{Binding CustoTotal, StringFormat='{0:C}'}" FontSize="28" TextColor="#38BDF8" FontAttributes="Bold" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <Button Text="Voltar / Novo Cadastro"
                    Clicked="BtnVoltar_Clicked"
                    BackgroundColor="#6366F1"
                    TextColor="#FFFFFF"
                    FontAttributes="Bold"
                    CornerRadius="20"
                    HeightRequest="48"
                    WidthRequest="220"
                    HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>