<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.SobrePage"
             Title="Sobre">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">

            <Label Text="Informações do Aplicativo" 
                   FontSize="22" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" />

            <Border Padding="20" Margin="0,10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Projeto: MauiAppLogin" FontAttributes="Bold" />
                    <Label Text="Desenvolvedor: Filipe Berlanga" />
                    <Label Text="Ano de Desenvolvimento: 2026" />
                    <Label Text="Curso: Técnico em Desenvolvimento de Sistemas" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Voltar" Clicked="BtnVoltar_Clicked" HorizontalOptions="Center" WidthRequest="150" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>