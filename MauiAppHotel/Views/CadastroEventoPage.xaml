<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.CadastroEventoPage"
             Title="Cadastro de Evento"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#0F172A">

    <ScrollView>
        <VerticalStackLayout Padding="20,30" Spacing="15">

            <Label Text="Cadastrar Evento"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#38BDF8" />

            <Frame Padding="15" BackgroundColor="#1E293B" BorderColor="#334155" CornerRadius="16">
                <VerticalStackLayout Spacing="12">

                    <!-- Nome do Evento -->
                    <Label Text="Nome do Evento:" TextColor="#94A3B8" />
                    <Entry x:Name="txt_nome" Placeholder="Ex: Workshop de .NET MAUI" TextColor="#F8FAFC" PlaceholderColor="#64748B" />

                    <!-- Local do Evento -->
                    <Label Text="Local do Evento:" TextColor="#94A3B8" />
                    <Entry x:Name="txt_local" Placeholder="Ex: Auditório Principal" TextColor="#F8FAFC" PlaceholderColor="#64748B" />

                    <!-- Custo por Participante -->
                    <Label Text="Custo por Participante (R$):" TextColor="#94A3B8" />
                    <Entry x:Name="txt_custo" Keyboard="Numeric" Placeholder="Ex: 50.00" TextColor="#F8FAFC" PlaceholderColor="#64748B" />

                    <BoxView HeightRequest="1" Color="#334155" />

                    <!-- Participantes (Stepper) -->
                    <Grid ColumnDefinitions="*, Auto, 2*">
                        <Label Grid.Column="0" Text="Participantes:" VerticalOptions="Center" TextColor="#94A3B8" />
                        <Label Grid.Column="1" Text="{Binding Value}" BindingContext="{x:Reference stp_participantes}" TextColor="#38BDF8" FontAttributes="Bold" FontSize="18" VerticalOptions="Center" Margin="0,0,10,0" />
                        <Stepper Grid.Column="2" x:Name="stp_participantes" Minimum="1" Maximum="1000" Increment="1" Value="1" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#334155" />

                    <!-- Datas (Check-in / Check-out do Evento) -->
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Data de Início:" VerticalOptions="Center" TextColor="#94A3B8" />
                        <DatePicker Grid.Column="1" x:Name="dtpck_inicio" Format="dd/MM/yyyy" TextColor="#F8FAFC" DateSelected="dtpck_inicio_DateSelected" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Data de Término:" VerticalOptions="Center" TextColor="#94A3B8" />
                        <DatePicker Grid.Column="1" x:Name="dtpck_termino" Format="dd/MM/yyyy" TextColor="#F8FAFC" />
                    </Grid>

                    <!-- Botão Cadastrar -->
                    <Button Text="Cadastrar Evento"
                            Clicked="BtnCadastrar_Clicked"
                            BackgroundColor="#6366F1"
                            TextColor="#FFFFFF"
                            FontAttributes="Bold"
                            CornerRadius="20"
                            HeightRequest="48"
                            Margin="0,10,0,0" />

                    <Button Text="Voltar ao Menu Principal"
                            Clicked="BtnVoltar_Clicked"
                            BackgroundColor="Transparent"
                            TextColor="#94A3B8"
                            FontAttributes="Bold" />    

                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>